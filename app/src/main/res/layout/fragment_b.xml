<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <!-- კიდევ დავწერ, ID-ებზე ინიციალები არის სახელი და გვარის ოღონდ ინგლისური (Luka Tchikadze) -->
    <!-- აქ გამოჩნდება კალკულაციის შედეგები შესაბამისი ფერით (თავიდან ნულებია, მაგრამ შეიცვლება კალკულაციის შემდეგ )   -->
    <TextView
        android:id="@+id/lt_txt_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/lt_txt_identity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Salary: 0.0\nRent: 0.0\nMeals: 0.0\nSavings: 0.0\nTotal Expenses: 0.0\nRemaining: 0.0" />

    <!-- აქ დავალების პირობის მიხედვით Name, Last Name, Year შეიცვლება კოტლინ კოდიდან ჩემი ნამდვილით (ინგლისურად) -->
    <TextView
        android:id="@+id/lt_txt_identity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lt_txt_result"
        tools:text="Name, Last Name, Year" />

</androidx.constraintlayout.widget.ConstraintLayout>